<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pegasus" parent="android:Theme.Material.NoActionBar">
        <!-- Primary brand color -->
        <item name="android:colorPrimary">@color/pegasus_blue</item>
        <!-- Secondary brand color -->
        <item name="android:colorSecondary">@color/pegasus_light_blue</item>
        <!-- Tertiary brand color -->
        <item name="android:colorTertiary">@color/pegasus_dark_blue</item>
        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/background</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Button Styles -->
    <style name="Pegasus.Button" parent="android:Widget.Material.Button">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@color/pegasus_blue</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Text Styles -->
    <style name="Pegasus.Text.Headline" parent="android:TextAppearance.Material.Headline">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Pegasus.Text.Subtitle" parent="android:TextAppearance.Material.Subhead">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
